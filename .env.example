# LOF套利雷达 - 配置文件示例
# 复制此文件为 .env 并填入实际值

# 腾讯云/服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=false

# 企业微信群机器人（必填）
# 1. 在企业微信电脑版中创建一个群
# 2. 群设置 → 群机器人 → 添加机器人
# 3. 复制webhook地址，key=后面的内容填入下面
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 邮件推送配置
MAIL_ENABLED=true
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
MAIL_FROM=your_email@qq.com
MAIL_TO=your_email@qq.com

# 数据刷新间隔（分钟）
REFRESH_INTERVAL=5

# 告警阈值
ALERT_THRESHOLD=3.0
SHOW_THRESHOLD=1.5

# Flask 会话签名密钥（生产环境必须配置固定强随机值！）
# 不配置时系统会在每次启动时生成临时随机密钥，重启后所有用户 session 失效
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 内部接口令牌：scheduler.py 调用 /api/refresh 时在 X-Internal-Token 请求头中携带
# 不配置则 /api/refresh 仅允许 admin 登录会话访问（调度器将收到 403）
# 生成方式: python -c "import secrets; print(secrets.token_hex(16))"
INTERNAL_TOKEN=

# A股法定节假日（逗号分隔 YYYY-MM-DD，按国务院公告每年更新）
# 留空则使用代码内置的当年预测值（scheduler.py / data_fetcher.py 中的 _DEFAULT_HOLIDAYS_2026）
A_SHARE_HOLIDAYS=
