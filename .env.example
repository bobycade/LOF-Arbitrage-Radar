# LOF套利雷达 - 配置文件示例
# 复制此文件为 .env 并填入实际值
# 变量名与代码读取严格对齐（app.py / scheduler.py / data_fetcher.py）

# ==================== 基础服务 ====================
# Flask 监听地址与端口（app.py）
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=false

# scheduler.py 调用本机 Flask 的地址（一般无需改）
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# ==================== 安全密钥（生产环境必须配置！） ====================
# Flask 会话签名密钥：不配置则每次启动生成临时随机密钥，重启后所有用户 session 失效
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 内部接口令牌：scheduler.py 调用 /api/refresh 时在 X-Internal-Token 请求头中携带
# 不配置则 /api/refresh 仅允许 admin 登录会话访问（调度器将收到 403，定时刷新失效）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=

# ==================== 告警推送（可选，不配置则不推送） ====================
# 企业微信群机器人 webhook：
# 1. 在企业微信电脑版中创建一个群
# 2. 群设置 → 群机器人 → 添加机器人
# 3. 复制完整 webhook 地址填入
WECHAT_WEBHOOK=

# 邮件推送（SMTP_PASSWORD 是邮箱授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# 告警阈值：扣费后净收益 >= 该值时推送（%）
ARBITRAGE_THRESHOLD_ALERT=3.0

# ==================== 数据采集 ====================
# 交易时段刷新间隔（分钟）
REFRESH_INTERVAL=5

# A股法定节假日（逗号分隔 YYYY-MM-DD，按国务院公告每年更新）
# 留空则使用代码内置的当年预测值（scheduler.py / data_fetcher.py 中的 _DEFAULT_HOLIDAYS_2026）
A_SHARE_HOLIDAYS=
