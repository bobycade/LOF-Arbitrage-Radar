# LOF套利雷达 - 配置文件示例
# 复制此文件为 .env 并填入实际值

# 腾讯云/服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# 企业微信群机器人（必填）
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 邮件推送配置
MAIL_ENABLED=true
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_auth_code
MAIL_FROM=your_email@qq.com
MAIL_TO=your_email@qq.com

# 数据刷新间隔（分钟）
REFRESH_INTERVAL=5

# 告警阈值
ALERT_THRESHOLD=3.0
SHOW_THRESHOLD=1.5
